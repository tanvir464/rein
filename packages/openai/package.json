{
  "name": "@rein/openai",
  "version": "0.1.0",
  "private": true,
  "description": "REIN — OpenAI Functions schema export.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
