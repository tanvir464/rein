{
  "name": "@rein/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "REIN — MCP server. Drop-in for Claude Code, Cursor, Claude Desktop.",
  "type": "module",
  "bin": {
    "rein-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@rein/sdk": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
