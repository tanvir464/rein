{
  "name": "@rein/langchain",
  "version": "0.1.0",
  "private": true,
  "description": "REIN — LangChain Tool wrappers around @rein/sdk.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.0"
  },
  "dependencies": {
    "@rein/sdk": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@langchain/core": "^0.3.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
