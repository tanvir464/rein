# REIN sidecar environment.
# Copy to .env locally; in production set via `fly secrets set`.

# 32-byte hex HMAC shared with the Cloudflare Worker.
# Generate: `openssl rand -hex 32`
SIDECAR_HMAC_KEY=

# Solana keypair (base58-encoded 64-byte secret) — the sidecar's own wallet.
# DO NOT reuse the delegate or owner key. Fund this with devnet SOL + run
# Umbra register({ confidential: true, anonymous: true }) before first use.
UMBRA_SIDECAR_KEYPAIR_BASE58=

# Solana RPC. Helius devnet recommended; public devnet RPC is rate-limited.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=
SOLANA_RPC_WS_URL=wss://devnet.helius-rpc.com/?api-key=

# Optional — overrides if Umbra moves their devnet indexer.
UMBRA_INDEXER_URL=https://utxo-indexer.api-devnet.umbraprivacy.com
UMBRA_NETWORK=devnet

# Server config.
PORT=8788
