{
  "name": "@rein/sidecar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "REIN-Cloak sidecar — Node service hosting Umbra SDK + ZK prover for the private spend path.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@solana/kit": "^4.0.0",
    "@solana/web3.js": "^1.95.0",
    "@umbra-privacy/sdk": "^4.0.0",
    "@umbra-privacy/web-zk-prover": "^1.0.0",
    "bs58": "^6.0.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
